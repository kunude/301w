# ============================================
# OpenWrt Passwall2 变体配置
# 核心引擎: Sing-box (Xray 已注释，可启用)
# 目标设备: QNAP 301w (ipq807x) - USB 已启用
# ============================================

# ---------- 基础平台 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_qnap_301w=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_OPTIONS=y
CONFIG_USE_GC_SECTIONS=y

# ---------- 开发/调试 (全部禁用) ----------
# CONFIG_DEVEL is not set
# CONFIG_EXPERIMENTAL is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_KERNEL_DYNAMIC_DEBUG is not set
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUILD_PATENTED=y

# ---------- OpenSSL 配置 ----------
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_OPENSSL_WITH_CHACHA_POLY1305=y
CONFIG_OPENSSL_WITH_CMS=y
CONFIG_OPENSSL_WITH_DEPRECATED=y
CONFIG_OPENSSL_WITH_ERROR_MESSAGES=y
CONFIG_OPENSSL_WITH_IDEA=y
CONFIG_OPENSSL_WITH_MDC2=y
CONFIG_OPENSSL_WITH_PSK=y
CONFIG_OPENSSL_WITH_SEED=y
CONFIG_OPENSSL_WITH_SRP=y
CONFIG_OPENSSL_WITH_TLS13=y
CONFIG_OPENSSL_WITH_WHIRLPOOL=y

# ---------- 包管理器 ----------
CONFIG_PACKAGE_apk-openssl=y
# CONFIG_PACKAGE_apk-mbedtls is not set

# ---------- Passwall2 核心 ----------
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y

# ════════════════════════════════════════
# 🔰 核心引擎 (Sing-box 为主)
# ════════════════════════════════════════
CONFIG_PACKAGE_sing-box=y          # ✅ 主引擎

# ---------- Xray (备选，注释掉以减小体积) ----------
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_v2ray-plugin is not set

# ---------- 规则文件 ----------
CONFIG_PACKAGE_v2ray-geosite=y     # ✅ 保留，Sing-box 兼容
CONFIG_PACKAGE_v2ray-geoip=y       # ✅ 保留，Sing-box 兼容

# ---------- 新协议支持 (Sing-box 专属) ----------
CONFIG_PACKAGE_hysteria=y          # Hysteria 协议
CONFIG_PACKAGE_shadow-tls=y        # Shadow-TLS 混淆
CONFIG_PACKAGE_tuic-client=y       # TUIC 协议

# ---------- 经典协议支持 ----------
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y

# ---------- Sing-box 依赖 ----------
CONFIG_PACKAGE_libcares=y
CONFIG_PACKAGE_libevent2=y
CONFIG_PACKAGE_libwebsockets=y

# ---------- Passwall2 基础依赖 ----------
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_chinadns-ng=y

# ---------- 网络基础 ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-iptables=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# ---------- NFTables (Passwall2 默认) ----------
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-tproxy=y

# ---------- 加密库 ----------
CONFIG_PACKAGE_kmod-crypto-kpp=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y
CONFIG_PACKAGE_libsodium=y
CONFIG_LIBSODIUM_MINIMAL=y

# ---------- 依赖库 ----------
CONFIG_PACKAGE_libev=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_PCRE2_JIT_ENABLED=y
CONFIG_PACKAGE_libudns=y
CONFIG_PACKAGE_libpcap=y

# ---------- LuCI 界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ---------- RPCD 模块 ----------
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

# ---------- 库文件 ----------
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libgmp=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_libltdl=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_liblua5.4=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-lua=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_libnettle=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-legacy=y
CONFIG_PACKAGE_libqrencode=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_libsysfs=y
CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set

# ---------- 系统工具 ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_LIBCURL_COOKIES=y
CONFIG_PACKAGE_LIBCURL_FILE=y
CONFIG_PACKAGE_LIBCURL_FTP=y
CONFIG_PACKAGE_LIBCURL_HTTP=y
CONFIG_PACKAGE_LIBCURL_HTTP2=y
CONFIG_PACKAGE_LIBCURL_HTTP_AUTH=y
CONFIG_PACKAGE_LIBCURL_MBEDTLS=y
CONFIG_PACKAGE_LIBCURL_NO_SMB="!"
CONFIG_PACKAGE_LIBCURL_PROXY=y
CONFIG_PACKAGE_LIBCURL_UNIX_SOCKETS=y
CONFIG_PACKAGE_LIBCURL_ZLIB=y

CONFIG_PACKAGE_haproxy=y
CONFIG_PACKAGE_htop=y
# CONFIG_HTOP_LMSENSORS is not set
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_unzip=y

# ---------- UDP 代理 ----------
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y

# ---------- 内核模块 ----------
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y

# ════════════════════════════════════════
# ✅ USB 存储支持 (QNAP 301w 有 USB 接口)
# ════════════════════════════════════════
CONFIG_PACKAGE_kmod-usb-storage=y        # USB 存储设备驱动
CONFIG_PACKAGE_kmod-scsi-core=y          # SCSI 核心支持
CONFIG_PACKAGE_kmod-usb-storage-uas=y    # UAS (USB Attached SCSI) 支持
CONFIG_PACKAGE_kmod-usb2=y               # USB 2.0 支持
CONFIG_PACKAGE_kmod-usb3=y               # USB 3.0 支持
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y       # USB 3.0 xHCI 控制器
CONFIG_PACKAGE_kmod-usb-dwc3=y           # DWC3 USB 控制器 (QNAP 301w 使用)
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y      # 高通 DWC3 支持

# ---------- 文件系统支持 (挂载 USB 存储) ----------
CONFIG_PACKAGE_kmod-fs-ext4=y            # EXT4 文件系统
CONFIG_PACKAGE_kmod-fs-vfat=y            # FAT32 文件系统
CONFIG_PACKAGE_kmod-fs-exfat=y           # exFAT 文件系统 (大文件)
CONFIG_PACKAGE_kmod-fs-ntfs=y            # NTFS 文件系统 (Windows)
CONFIG_PACKAGE_kmod-fs-ntfs3=y           # NTFS3 (新驱动，性能更好)
CONFIG_PACKAGE_kmod-fuse=y               # FUSE 支持 (NTFS-3G 需要)

# ---------- USB 工具 ----------
CONFIG_PACKAGE_usbutils=y                # lsusb 命令
CONFIG_PACKAGE_blkid=y                   # 块设备识别
CONFIG_PACKAGE_block-mount=y             # 块设备挂载 (已启用)
CONFIG_PACKAGE_e2fsprogs=y               # EXT 文件系统工具
CONFIG_PACKAGE_ntfs-3g=y                 # NTFS-3G 挂载工具 (NTFS 读写)

# ---------- 挂载/自动挂载 ----------
CONFIG_PACKAGE_kmod-autofs4=y            # 自动挂载支持

# ════════════════════════════════════════
# 🌐 LuCI 中文支持
# ════════════════════════════════════════
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y      # ⚠️ 必须！LuCI 基础中文翻译
CONFIG_PACKAGE_LUCI_LANG_zh_Hans=y         # LuCI 简体中文语言选择

# ---------- DDNS-Go ----------
CONFIG_PACKAGE_luci-app-ddns-go=y          # DDNS-Go Web 界面
CONFIG_PACKAGE_ddns-go=y                   # DDNS-Go 核心程序
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y   # DDNS-Go 中文语言包

CONFIG_PACKAGE_luci-app-temp-status=y


# ════════════════════════════════════════
# ❌ 禁用：网络调试/测试工具 (生产环境不需要)
# ════════════════════════════════════════
# CONFIG_PACKAGE_tcpdump is not set      # 网络抓包工具
# CONFIG_PACKAGE_iperf3 is not set       # 带宽测试工具
# CONFIG_PACKAGE_ethtool is not set      # 网卡配置工具

# ════════════════════════════════════════
# ❌ 禁用：文本编辑器 (用 vi 替代)
# ════════════════════════════════════════
# CONFIG_PACKAGE_nano is not set         # 文本编辑器

# ════════════════════════════════════════
# ❌ 禁用：数据处理工具 (一般用户不需要)
# ════════════════════════════════════════
# CONFIG_PACKAGE_jq is not set           # JSON 处理工具

# ════════════════════════════════════════
# ❌ 禁用：GNU Coreutils 扩展工具 (BusyBox 已提供)
# ════════════════════════════════════════
# CONFIG_PACKAGE_coreutils is not set
# CONFIG_PACKAGE_coreutils-base64 is not set
# CONFIG_PACKAGE_coreutils-nohup is not set
# CONFIG_PACKAGE_coreutils-timeout is not set

# ════════════════════════════════════════
# ❌ 禁用：传感器监控工具 (路由器不需要)
# ════════════════════════════════════════
# CONFIG_PACKAGE_lm-sensors is not set
# CONFIG_PACKAGE_sysfsutils is not set

# ════════════════════════════════════════
# ❌ 禁用：Wi-Fi (不需要无线功能)
# ════════════════════════════════════════
# CONFIG_PACKAGE_ath11k-firmware-ipq8074 is not set
# CONFIG_PACKAGE_ipq-wifi-qnap_301w is not set
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-crypto-aead is not set
# CONFIG_PACKAGE_kmod-crypto-ccm is not set
# CONFIG_PACKAGE_kmod-crypto-cmac is not set
# CONFIG_PACKAGE_kmod-crypto-ctr is not set
# CONFIG_PACKAGE_kmod-crypto-gcm is not set
# CONFIG_PACKAGE_kmod-crypto-gf128 is not set
# CONFIG_PACKAGE_kmod-crypto-ghash is not set
# CONFIG_PACKAGE_kmod-crypto-hmac is not set
# CONFIG_PACK
