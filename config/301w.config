# ============================================
# Target: QNAP 301W (IPQ8072A / qualcommax/ipq807x)
# ImmortalWrt master branch
# ============================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_qnap_301w=y

# Image options
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ============================================
# 基础系统
# ============================================
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# ============================================
# 默认设置 (中国版优化)
# ============================================
CONFIG_PACKAGE_default-settings-chn=y

# ============================================
# DNS/DHCP
# ============================================
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ============================================
# SSH
# ============================================
CONFIG_PACKAGE_dropbear=y

# ============================================
# 防火墙
# ============================================
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-nathelper=y

# ============================================
# 存储/文件系统
# ============================================
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

# ============================================
# USB 支持
# ============================================
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb3=y

# ============================================
# 无线 (ath11k Wi-Fi 6)
# ============================================
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq8074 is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_ipq-wifi-qnap_301w is not set

# ============================================
# 10G PHY (Aquantia - 301W 必需)
# ============================================
# CONFIG_PACKAGE_kmod-phy-aquantia is not set


# ============================================
# NSS 硬件加速 (IPQ807x 性能关键)
# ============================================
# CONFIG_PACKAGE_kmod-qca-nss-dp is not set

# ============================================
# GPIO/LED/按钮
# ============================================
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# ============================================
# LuCI Web 界面
# ============================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-cpufreq=y

# ============================================
# 网络工具
# ============================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ============================================
# U-Boot 工具
# ============================================
CONFIG_PACKAGE_uboot-envtools=y

# ============================================
# SSL 支持
# ============================================
CONFIG_PACKAGE_libustream-openssl=y

# ============================================
# 自动核心调频
# ============================================
CONFIG_PACKAGE_autocore=y

#
# PassWall (代理软件)
#
CONFIG_PACKAGE_luci-app-passwall=y
# PassWall 核心代理组件 (注释掉避免与 homeproxy 循环依赖)
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_xray-core=y
# 可选：其他协议支持 (按需启用)
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-redir is not set
# CONFIG_PACKAGE_v2ray-core is not set

CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_shadow-tls=y
CONFIG_PACKAGE_shadowsocksr-libev=y
CONFIG_PACKAGE_simple-obfs=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_v2ray-geodata=y
CONFIG_PACKAGE_v2ray-plugin=y
CONFIG_PACKAGE_xray-plugin=y



#
# 透明代理所需内核模块
#
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y


#
# DDNS-Go
#
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y


#
# UDPXY
#
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y
CONFIG_PACKAGE_udpxy=y

#
# WireGuard
#
CONFIG_PACKAGE_luci-proto-wireguard=y
# CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

#
# QRencode
#
CONFIG_PACKAGE_qrencode=y

CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
